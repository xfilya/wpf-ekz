<Window x:Class="WpfAppTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppTest"
        mc:Ignorable="d"
        Title="Чудо Обувь - Каталог" Height="450" Width="800" FontFamily="Calibri" Background="White" Icon="Assets/ChudoObuv.ico">
    <Grid Margin="20,20,20,20"
          >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>


        </Grid.RowDefinitions>

        <Border Background="#D2F6E7"
        Padding="10"
        Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/Logo.png"
               Width="50"
               Height="50"
               Stretch="Uniform"
               Margin="0,0,15,0"/>

                <TextBlock x:Name="ResultText"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ListView x:Name="ProductsList" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding ImagePath}"
                               Width="120"
                               Height="120"
                               Stretch="Uniform"
                               VerticalAlignment="Top"
                               Margin="0,0,15,0"/>  

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Product.Category.name}"></TextBlock>
                            <TextBlock Text="{Binding Product.name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Производитель: "></TextBlock>
                                <TextBlock Text="{Binding Product.Manufacturer.name}"></TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding Product.composition}" TextWrapping="Wrap" Margin="0,5,0,5"></TextBlock>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Цена: "></TextBlock>
                                <TextBlock Text="{Binding Price}"></TextBlock>
                                <TextBlock Text="$"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Наличие: "></TextBlock>
                                <TextBlock Text="{Binding StockText}" FontWeight="Bold"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>



    </Grid>
</Window>
